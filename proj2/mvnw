#!/usr/bin/env sh
# Apache Maven Wrapper startup script
set -e
MVN_CMD="mvn"
WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPS=".mvn/wrapper/maven-wrapper.properties"
if [ ! -f "$WRAPPER_JAR" ]; then
  mkdir -p .mvn/wrapper
  curl -fsSL "https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar" -o "$WRAPPER_JAR"
fi
exec "$MVN_CMD" "$@"
